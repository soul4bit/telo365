# Copy outside the repository as /etc/telo365/mail.env and chmod 600.
# capture is a local-only test mailbox. smtp needs a real provider and DNS records.
MAIL_MODE=capture
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_PUBLIC_URL=https://telo365.ru
MAIL_FROM=no-reply@telo365.ru
# MAIL_USER=
# MAIL_PASSWORD=
